digraph Stage3 {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.8, splines=polyline, fontname="Helvetica", fontsize=13, labelloc=t, label="Restaurant Rush Stage 3 | Final UML class diagram\nKey members shown; reference fields are represented by named association ends."];
node [shape=plain, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, color="#52677c", arrowsize=0.85];
RestaurantCLI [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#e7edf7"><FONT POINT-SIZE="10">&lt;&lt;boundary&gt;&gt;</FONT><BR/><B>RestaurantCLI</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- scanner: Scanner {readOnly}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ main(args: String[]): void {static}<BR ALIGN="LEFT"/>+ promptTurnStart(c: RestaurantController): void<BR ALIGN="LEFT"/>+ promptHostAction(c: RestaurantController): void<BR ALIGN="LEFT"/>+ promptWaiterAction(c: RestaurantController): int<BR ALIGN="LEFT"/>+ promptChefAction(c: RestaurantController): int<BR ALIGN="LEFT"/>+ displayTurnStart(c: RestaurantController): void<BR ALIGN="LEFT"/>+ displayTurnSummary(c: RestaurantController): void<BR ALIGN="LEFT"/>+ displayGameOver(r: GameResult, c: RestaurantController): void<BR ALIGN="LEFT"/>- readInt(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
RestaurantController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#e7edf7"><FONT POINT-SIZE="10">&lt;&lt;control&gt;&gt;</FONT><BR/><B>RestaurantController</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- currentTurn: int = 1<BR ALIGN="LEFT"/>- maxTurns: int = 18 {readOnly}<BR ALIGN="LEFT"/>- revenueCents: int = 0<BR ALIGN="LEFT"/>- paidCustomersCount: int = 0<BR ALIGN="LEFT"/>- totalPaidSatisfaction: int = 0<BR ALIGN="LEFT"/>- servedCount: int; - unhappyDepartures: int<BR ALIGN="LEFT"/>- turnStarted: boolean<BR ALIGN="LEFT"/>- nextCustomerId: int; - nextOrderId: int<BR ALIGN="LEFT"/>- arrivalTurns: List&lt;Integer&gt; {readOnly}<BR ALIGN="LEFT"/>- customerTypes: List&lt;Integer&gt; {readOnly}<BR ALIGN="LEFT"/>- customerTypeIndex: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ RestaurantController()<BR ALIGN="LEFT"/>+ startTurn(activateHappyHour: boolean): boolean<BR ALIGN="LEFT"/>+ executeHostTask(tableId: int): boolean<BR ALIGN="LEFT"/>+ executeWaiterTask(choice: int, target: int): boolean<BR ALIGN="LEFT"/>+ executeChefTask(orderId: int): boolean<BR ALIGN="LEFT"/>+ executeTurn(): void<BR ALIGN="LEFT"/>+ getTableById(tableId: int): Table<BR ALIGN="LEFT"/>+ getOrderById(orderId: int): Order<BR ALIGN="LEFT"/>+ getTables(): List&lt;Table&gt;<BR ALIGN="LEFT"/>+ getWaitingQueue(): List&lt;Customer&gt;<BR ALIGN="LEFT"/>+ getMenu(): List&lt;MenuItem&gt;<BR ALIGN="LEFT"/>+ canActivateHappyHour(): boolean<BR ALIGN="LEFT"/>+ getHappyHourRemainingTurns(): int<BR ALIGN="LEFT"/>+ getAverageSatisfaction(): double<BR ALIGN="LEFT"/>+ checkGameResult(): GameResult<BR ALIGN="LEFT"/>+ isGameOver(): boolean<BR ALIGN="LEFT"/>- generateCustomerTypes(): void<BR ALIGN="LEFT"/>- checkAndProcessArrival(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Staff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;abstract&gt;&gt;</FONT><BR/><B>Staff</B></TD></TR><HR/><TR><TD ALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># hasActedThisTurn: boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Staff(id: int)<BR ALIGN="LEFT"/>+ getId(): int<BR ALIGN="LEFT"/>+ setActed(acted: boolean): void<BR ALIGN="LEFT"/>+ hasActed(): boolean<BR ALIGN="LEFT"/>+ resetTurn(): void<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Host [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#e8f4f0"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Host</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Host(id: int)<BR ALIGN="LEFT"/>+ seatCustomer(c: Customer, t: Table): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Waiter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Waiter</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Waiter(id: int)<BR ALIGN="LEFT"/>+ seatCustomer(c: Customer, t: Table): boolean<BR ALIGN="LEFT"/>+ takeOrder(t: Table, i: MenuItem, id: int): Order<BR ALIGN="LEFT"/>+ takeOrder(t: Table, i: MenuItem, id: int, billCents: int): Order<BR ALIGN="LEFT"/>+ serveOrder(t: Table): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Chef [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Chef</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Chef(id: int)<BR ALIGN="LEFT"/>+ cookOrder(order: Order): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Cashier [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Cashier</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Cashier(id: int)<BR ALIGN="LEFT"/>+ processPayment(table: Table): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Customer</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- satisfaction: int<BR ALIGN="LEFT"/>- arrivalTurn: int<BR ALIGN="LEFT"/>- status: CustomerStatus<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Customer(id: int, arrivalTurn: int)<BR ALIGN="LEFT"/>+ getId(): int; + getArrivalTurn(): int<BR ALIGN="LEFT"/>+ getSatisfaction(): int<BR ALIGN="LEFT"/>+ getStatus(): CustomerStatus<BR ALIGN="LEFT"/>+ setStatus(status: CustomerStatus): void<BR ALIGN="LEFT"/>+ orderFood(menu: List&lt;MenuItem&gt;): MenuItem<BR ALIGN="LEFT"/>+ recoverSatisfaction(amount: int): void<BR ALIGN="LEFT"/>+ reduceSatisfaction(amount: int): void<BR ALIGN="LEFT"/>+ isAbandoned(): boolean<BR ALIGN="LEFT"/>+ getSatisfactionLoss(): int<BR ALIGN="LEFT"/>+ getDiscountedPrice(priceCents: int): int<BR ALIGN="LEFT"/>+ getCustomerType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
VIPCustomer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>VIPCustomer</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ VIPCustomer(customerId: int, arrivalTurn: int)<BR ALIGN="LEFT"/>+ getSatisfactionLoss(): int<BR ALIGN="LEFT"/>+ getDiscountedPrice(priceCents: int): int<BR ALIGN="LEFT"/>+ getCustomerType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CriticCustomer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>CriticCustomer</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ CriticCustomer(id: int, arrivalTurn: int)<BR ALIGN="LEFT"/>+ getSatisfactionLoss(): int<BR ALIGN="LEFT"/>+ orderFood(menu: List&lt;MenuItem&gt;): MenuItem<BR ALIGN="LEFT"/>+ getCustomerType(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Table [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Table</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- tableId: int<BR ALIGN="LEFT"/>- isOccupied: boolean<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Table(tableId: int)<BR ALIGN="LEFT"/>+ getTableId(): int<BR ALIGN="LEFT"/>+ isOccupied(): boolean<BR ALIGN="LEFT"/>+ getCurrentCustomer(): Customer<BR ALIGN="LEFT"/>+ getCurrentOrder(): Order<BR ALIGN="LEFT"/>+ seatCustomer(customer: Customer): void<BR ALIGN="LEFT"/>+ assignOrder(order: Order): void<BR ALIGN="LEFT"/>+ clearTable(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Order [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>Order</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- orderId: int<BR ALIGN="LEFT"/>- remainingUnits: int<BR ALIGN="LEFT"/>- status: OrderStatus<BR ALIGN="LEFT"/>- billCents: int {readOnly}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Order(orderId: int, item: MenuItem)<BR ALIGN="LEFT"/>+ Order(orderId: int, item: MenuItem, billCents: int)<BR ALIGN="LEFT"/>+ getOrderId(): int; + getRemainingUnits(): int<BR ALIGN="LEFT"/>+ getStatus(): OrderStatus<BR ALIGN="LEFT"/>+ getItem(): MenuItem; + getPrice(): int<BR ALIGN="LEFT"/>+ setStatus(status: OrderStatus): void<BR ALIGN="LEFT"/>+ advancePrep(): void; + isReady(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MenuItem [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>MenuItem</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- name: String {readOnly}<BR ALIGN="LEFT"/>- priceCents: int {readOnly}<BR ALIGN="LEFT"/>- prepUnits: int {readOnly}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ MenuItem(name: String, priceCents: int, prepUnits: int)<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getPriceCents(): int<BR ALIGN="LEFT"/>+ getPrepUnits(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ComboMeal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#e8f4f0"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>ComboMeal</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ ComboMeal(first: MenuItem, second: MenuItem)<BR ALIGN="LEFT"/>+ getFirst(): MenuItem; + getSecond(): MenuItem<BR ALIGN="LEFT"/>- nameOf(first: MenuItem, second: MenuItem): String {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
HappyHourPolicy [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#e8f4f0"><FONT POINT-SIZE="10">&lt;&lt;entity&gt;&gt;</FONT><BR/><B>HappyHourPolicy</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- used: boolean<BR ALIGN="LEFT"/>- remainingTurns: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ activate(): boolean<BR ALIGN="LEFT"/>+ hasBeenUsed(): boolean<BR ALIGN="LEFT"/>+ isActive(): boolean<BR ALIGN="LEFT"/>+ getRemainingTurns(): int<BR ALIGN="LEFT"/>+ priceFor(customer: Customer, item: MenuItem): int<BR ALIGN="LEFT"/>+ endTurn(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
CustomerStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>CustomerStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT">QUEUED<BR ALIGN="LEFT"/>SEATED<BR ALIGN="LEFT"/>SERVED<BR ALIGN="LEFT"/>EATING<BR ALIGN="LEFT"/>READY_TO_PAY<BR ALIGN="LEFT"/>PAID<BR ALIGN="LEFT"/>ABANDONED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OrderStatus [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>OrderStatus</B></TD></TR><HR/><TR><TD ALIGN="LEFT">ORDERED<BR ALIGN="LEFT"/>PREPARING<BR ALIGN="LEFT"/>READY<BR ALIGN="LEFT"/>SERVED<BR ALIGN="LEFT"/>PAID<BR ALIGN="LEFT"/>CANCELLED<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
GameResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#34465c"><TR><TD BGCOLOR="#f1f4f7"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;</FONT><BR/><B>GameResult</B></TD></TR><HR/><TR><TD ALIGN="LEFT">IN_PROGRESS<BR ALIGN="LEFT"/>VICTORY<BR ALIGN="LEFT"/>DEFEAT<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Host -> Staff [arrowhead=empty, color="#233c59"];
Waiter -> Staff [arrowhead=empty, color="#233c59"];
Chef -> Staff [arrowhead=empty, color="#233c59"];
Cashier -> Staff [arrowhead=empty, color="#233c59"];
VIPCustomer -> Customer [arrowhead=empty, color="#233c59"];
CriticCustomer -> Customer [arrowhead=empty, color="#233c59"];
ComboMeal -> MenuItem [arrowhead=empty, color="#233c59"];
RestaurantCLI -> RestaurantController [style=dashed, arrowhead=vee, label="uses (method parameter / main local)"];
RestaurantController -> Table [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="2", label="- tables", labeldistance=2];
RestaurantController -> Waiter [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="- waiter", labeldistance=2];
RestaurantController -> Host [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="- host", labeldistance=2];
RestaurantController -> Chef [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="- chef", labeldistance=2];
RestaurantController -> Cashier [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="- cashier", labeldistance=2];
RestaurantController -> HappyHourPolicy [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1", label="- happyHour", labeldistance=2];
RestaurantController -> Customer [arrowhead=vee, taillabel="1", headlabel="0..6", label="- waitingQueue", labeldistance=2];
RestaurantController -> MenuItem [arrowhead=vee, taillabel="1", headlabel="6", label="- menu", labeldistance=2];
Table -> Customer [arrowhead=vee, taillabel="0..1", headlabel="0..1", label="- currentCustomer", labeldistance=2];
Table -> Order [arrowhead=vee, taillabel="0..1", headlabel="0..1", label="- currentOrder", labeldistance=2];
Order -> MenuItem [arrowhead=vee, taillabel="0..*", headlabel="1", label="- item", labeldistance=2];
ComboMeal -> MenuItem [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="0..*", headlabel="2", label="- first / - second {shared}", constraint=false];
Customer -> CustomerStatus [style=dashed, arrowhead=vee, label="uses"];
Order -> OrderStatus [style=dashed, arrowhead=vee, label="uses"];
RestaurantController -> GameResult [style=dashed, arrowhead=vee, label="uses"];
HappyHourPolicy -> Customer [style=dashed, arrowhead=vee, constraint=false];
HappyHourPolicy -> MenuItem [style=dashed, arrowhead=vee, constraint=false];
Waiter -> Order [style=dashed, arrowhead=vee, constraint=false];
Host -> Table [style=dashed, arrowhead=vee, constraint=false];
Chef -> Order [style=dashed, arrowhead=vee, constraint=false];
Cashier -> Table [style=dashed, arrowhead=vee, constraint=false];
Encapsulation [shape=note, style=filled, fillcolor="#fff8df", label="ENCAPSULATION\lCustomer satisfaction is private; recovery is capped at 100.\lOrder billCents is final and is read at payment.\lController exposes unmodifiable collection views.\l"];
Polymorphism [shape=note, style=filled, fillcolor="#fff8df", label="POLYMORPHISM\lCustomer.getSatisfactionLoss(), getDiscountedPrice() and\lorderFood() dispatch to VIP / Critic overrides.\lComboMeal is accepted wherever MenuItem is expected.\l"];
CompositionNote [shape=note, style=filled, fillcolor="#fff8df", label="COMPOSITION AND SHARED PARTS\lController creates and owns its policy, staff and two tables.\lComboMeal has two shared component references; hollow\ldiamond denotes aggregation, not exclusive lifetime ownership.\l"];
Legend [shape=note, style=filled, fillcolor="#fff8df", label="NOTATION AND SCOPE\l+ public   - private   # protected   {readOnly} final\lHollow triangle: inheritance; filled diamond: composition.\lSolid arrow: navigable association; dashed: dependency.\lMultiplicities describe one base-setting game.\lRoutine controller getters and repeated inherited members omitted.\l"];
{rank=same; Encapsulation; Polymorphism; CompositionNote; Legend;}
Customer -> Encapsulation [style=invis];
ComboMeal -> CompositionNote [style=invis];
GameResult -> Legend [style=invis];
VIPCustomer -> Polymorphism [style=invis];
}
